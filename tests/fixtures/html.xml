<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixture for Mode::Html.

  Mode::Html targets libxml2's HTML parse tree, whose element and
  attribute names are lowercased and carry no namespace. This file is
  that tree written out as XML, so that a pure-Rust XML parser can stand
  in for libxml2's HTML parser: same shape, same names, no namespace.
  Element content is therefore already normalised (no implied tbody, no
  omitted end tags) — this fixture tests the translation, not the HTML
  parser.

  Attribute *values* keep their original case, because HTML's
  case-insensitive comparison for attributes such as `type` is something
  the translated XPath is supposed to do, not something the tree does.
-->
<html id="doc" lang="en">
  <body id="body">
    <form id="f1">
      <fieldset id="fs1" disabled="">
        <legend id="lg1"><input id="i1" type="TEXT"/></legend>
        <input id="i2" type="text"/>
      </fieldset>
      <input id="i3" type="CHECKBOX" checked=""/>
      <input id="i4" type="checkbox"/>
      <input id="i5" type="radio" checked="checked"/>
      <select id="se1">
        <option id="o1" selected="">A</option>
        <option id="o2">B</option>
      </select>
      <a id="a1" href="/x" class="Nav">x</a>
      <a id="a2" class="nav">y</a>
    </form>
    <p id="p1" lang="fr">bonjour</p>
    <p id="p2">hello</p>
  </body>
</html>
